# ─────────────────────────────────────────────────────────────
# SALIN file ini menjadi .env lalu isi dengan nilai asli kamu
# cp .env.example .env
#
# KEAMANAN:
#   - Variabel tanpa prefix VITE_ → hanya ada di SERVER (aman)
#   - Variabel dengan prefix VITE_ → di-bundle ke browser (tidak boleh berisi secret)
# ─────────────────────────────────────────────────────────────

# ── Mode AI (frontend-safe, boleh VITE_) ─────────────────────
# 'gemini-only'    → pakai Gemini langsung (untuk deploy online/Vercel)
# 'langflow-first' → pakai LangFlow dulu, fallback Gemini (untuk demo live lokal)
VITE_AI_MODE=gemini-only

# ── Google Gemini API Key (SERVER ONLY — jangan pakai prefix VITE_) ──
# Diakses hanya oleh: api/chat.js dan api/ocr.js
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── LangFlow Desktop (SERVER ONLY — hanya untuk demo live lokal) ──
# Diakses hanya oleh: api/langflow.js
# Jalankan: vercel dev (bukan npm run dev) agar /api berfungsi secara lokal
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_FLOW_ID=ecbe443a-cafc-4991-a25e-1fdee7d85b75
LANGFLOW_API_KEY=your_langflow_api_key_here
